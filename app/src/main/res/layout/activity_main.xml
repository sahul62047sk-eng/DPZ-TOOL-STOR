<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <ImageView android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center" android:src="@drawable/sahul" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="Sahul Unlimited Cloner" android:textSize="20sp" android:textStyle="bold" android:layout_marginTop="8dp" android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnStartBg" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Background Keep-Alive ON Karein" />
    <Button android:id="@+id/btnSetupProfile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Original Isolated Space Banayein" android:layout_marginTop="8dp" />
    <EditText android:id="@+id/etPackageName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Package Name (e.g. com.jio.myjio)" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnCloneApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="+ Unlimited Clone Add Karein" />
    <ListView android:id="@+id/lvClones" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp" />
</LinearLayout>
